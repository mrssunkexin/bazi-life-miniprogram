/* pages/zeji-result/zeji-result.wxss */
.result-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-content {
  flex: 1;
}

.item-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.date-range {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.header-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.action-icon {
  font-size: 32rpx;
}

.action-text {
  font-size: 22rpx;
  color: #ffffff;
}

.result-stats {
  padding: 30rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.results-list {
  padding: 0 30rpx;
}

.result-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.date-block {
  flex-shrink: 0;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.date-month {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.date-day {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 8rpx;
}

.date-weekday {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.info-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  min-width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

.load-more-section {
  padding: 40rpx 0;
  text-align: center;
}

.load-more-btn {
  background-color: #667eea;
  color: #ffffff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}

.load-more-btn[disabled] {
  background-color: #cccccc;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 24rpx;
}

/* 日期选择器弹窗 */
.date-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.date-picker-content {
  background-color: #ffffff;
  border-radius: 20rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
}

.date-picker-header {
  padding: 40rpx 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  border-bottom: 1rpx solid #eeeeee;
}

.date-picker-body {
  padding: 40rpx 30rpx;
}

.date-input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.date-label {
  font-size: 28rpx;
  color: #666666;
}

.date-picker-value {
  padding: 16rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

.date-hint {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.date-picker-footer {
  display: flex;
  border-top: 1rpx solid #eeeeee;
}

.date-picker-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
  background-color: transparent;
  border-radius: 0;
}

.cancel-btn {
  color: #999999;
  border-right: 1rpx solid #eeeeee;
}

.confirm-btn {
  color: #667eea;
  font-weight: bold;
}
